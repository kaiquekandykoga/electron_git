{
  "name": "electron_git",
  "version": "1.0.0",
  "description": "",
  "type": "commonjs",
  "main": "dist/main/index.js",
  "scripts": {
    "start": "npm run build && electron .",
    "build": "tsc -p tsconfig.build.json && npm run copy:assets",
    "copy:assets": "mkdir -p dist/renderer && cp src/renderer/index.html src/renderer/index.css dist/renderer/",
    "lint": "eslint .",
    "test": "jest",
    "ci": "npm run lint && npm test",
    "package": "electron-builder"
  },
  "author": "Kaíque Kandy Koga",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.3.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0"
  },
  "build": {
    "appId": "com.electrongit.app",
    "productName": "Electron git",
    "files": [
      "dist/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
