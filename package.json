{
  "name": "electron_git",
  "version": "1.0.0",
  "description": "",
  "type": "commonjs",
  "main": "dist/main/index.js",
  "scripts": {
    "start": "npm run build && electron .",
    "build": "tsc -p tsconfig.build.json && npm run copy:assets",
    "copy:assets": "mkdir -p dist/renderer && cp src/renderer/index.html src/renderer/index.css dist/renderer/",
    "lint": "eslint .",
    "test": "jest",
    "package": "electron-builder"
  },
  "author": "Kaíque Kandy Koga",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.0.0",
    "globals": "^17.11.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.2.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0"
  },
  "build": {
    "appId": "com.electrongit.app",
    "productName": "ElectronGit",
    "files": [
      "dist/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
