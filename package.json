{
  "name": "electron_git",
  "version": "1.0.0",
  "description": "",
  "type": "commonjs",
  "main": "dist/main/index.js",
  "scripts": {
    "start": "npm run build && electron .",
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.renderer.json && npm run build:renderer && npm run copy:assets",
    "build:renderer": "node scripts/build-renderer.js",
    "copy:assets": "node scripts/copy-assets.js",
    "lint": "eslint .",
    "test": "jest",
    "ci": "npm run lint && npm test",
    "package": "electron-builder",
    "release": "electron-builder --publish always"
  },
  "author": "Kaíque Kandy Koga",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0"
  },
  "build": {
    "appId": "com.electrongit.app",
    "productName": "Electron git",
    "files": [
      "dist/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "win": {
      "target": "nsis",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "draft"
      }
    ]
  },
  "dependencies": {
    "js-yaml": "^4.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
